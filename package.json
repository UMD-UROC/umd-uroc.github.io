{
  "name": "umd-uroc-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vp dev",
    "build": "bun node_modules/vite-plus/bin/vp build",
    "preview": "bun node_modules/vite-plus/bin/vp preview",
    "check": "bun node_modules/vite-plus/bin/vp check",
    "test": "bun node_modules/vite-plus/bin/vp test --run",
    "prepare": "bun node_modules/vite-plus/bin/vp config --no-hooks --no-agent && git config core.hooksPath .vite-hooks"
  },
  "dependencies": {
    "markdown-it": "^15.0.2"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite-plus": "^1.0.0"
  },
  "packageManager": "bun@1.4.2",
  "portless": "umd-uroc"
}
